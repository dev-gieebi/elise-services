# Copiez ce fichier en ".env.local" pour travailler en local,
# et ajoutez les mêmes variables dans Vercel (Settings > Environment Variables).

# Supabase > Project Settings > API > Project URL
# (juste le domaine, SANS /rest/v1 à la fin)
SUPABASE_URL=https://cpaikvzkvyasfelacuce.supabase.co

# Supabase > Project Settings > API Keys > service_role (ou "Secret keys" > sb_secret_...)
# NE JAMAIS la partager — ce n'est PAS la clé anon/publishable
SUPABASE_SERVICE_ROLE_KEY=collez_ici_votre_cle_service_role

# Une longue phrase secrète aléatoire (au moins 32 caractères) pour signer les sessions
JWT_SECRET=collez_ici_une_longue_chaine_aleatoire
